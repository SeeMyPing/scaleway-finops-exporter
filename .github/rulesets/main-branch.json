{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "require_code_owner_review": true,
        "dismiss_stale_reviews_on_push": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "go mod tidy",
            "integration_id": 15368
          },
          {
            "context": "golangci-lint (includes gofumpt and goimports)",
            "integration_id": 15368
          },
          {
            "context": "Tests and coverage",
            "integration_id": 15368
          },
          {
            "context": "govulncheck",
            "integration_id": 15368
          },
          {
            "context": "promtool, manifests and dashboard",
            "integration_id": 15368
          },
          {
            "context": "Build linux/amd64",
            "integration_id": 15368
          },
          {
            "context": "Build linux/arm64",
            "integration_id": 15368
          },
          {
            "context": "Build darwin/amd64",
            "integration_id": 15368
          },
          {
            "context": "Build darwin/arm64",
            "integration_id": 15368
          },
          {
            "context": "hadolint",
            "integration_id": 15368
          },
          {
            "context": "Container image (build and scan)",
            "integration_id": 15368
          },
          {
            "context": "Analyze (go)",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "security_alerts_threshold": "high_or_higher",
            "alerts_threshold": "errors"
          }
        ]
      }
    }
  ]
}
